---
const { headline, tekst, image } = Astro.props;
import { Image } from "astro:assets";
---

<article>
  <h2>{headline}</h2>
  <p>{tekst}</p>
  <Image src={image} alt="et billede af noget" width="200" height="200" />
</article>

<style>
  article {
    border: 1px solid black;
    width: 200px;
  }
  h2 {
    color: blue;
  }
  img {
  }
</style>
